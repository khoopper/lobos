# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Supabase project settings (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# URL pública canónica usada por SEO, sitemap y Open Graph.
NEXT_PUBLIC_SITE_URL=https://lobos-chi.vercel.app

# Service role key — SERVER-ONLY. Never import this in a "use client" file or
# send it to the browser. Used for: creating worker/admin accounts, seeding.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Next.js 16: a stable key so encrypted Server Action closures keep working
# across deployments/serverless instances. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
